# ==============================================================================
# ResumeIQ AI — Frontend Environment Template (frontend/.env.example)
# ==============================================================================
# This template defines environment variables for the Next.js web application.
# Location: frontend/.env.example
# Copy this file to: frontend/.env.local (or root .env)
#
# SECURITY NOTICE:
# - Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JavaScript.
# - NEVER place backend private keys (e.g. STRIPE_SECRET_KEY, DATABASE_URL,
#   GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY) in this file.
# ==============================================================================

# ==============================================================================
# 1. API CONNECTION & CANONICAL WEB URL
# ==============================================================================

# FastAPI Backend API Base URL
# Status: REQUIRED
# Points the Next.js client to the running FastAPI server endpoints
# Local: http://127.0.0.1:8000/api
# Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Canonical Web Application URL (used for SEO canonicals, sitemaps, OpenGraph metadata)
# Status: REQUIRED in Production | OPTIONAL in Development (Defaults to http://localhost:3000)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ==============================================================================
# 2. AUTHENTICATION & SESSION MANAGEMENT
# ==============================================================================

# NextAuth Session Encryption Secret (Server-only; not exposed to browser bundle)
# Status: OPTIONAL (Required if using NextAuth session signing)
# Generate with: openssl rand -base64 32
# Local: replace_with_secure_random_secret
# Production: 32+ character high-entropy random secret
NEXTAUTH_SECRET=replace_with_secure_random_secret

# NextAuth Canonical Base URL
# Status: OPTIONAL (Defaults to NEXT_PUBLIC_SITE_URL or Vercel URL)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Client ID (Feature: Planned / Not yet implemented in core auth routes)
# Status: OPTIONAL
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_your_google_client_id

# Google OAuth Client Secret (Server-only; not exposed to browser bundle)
# Status: OPTIONAL
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret


# ==============================================================================
# 3. CLIENT BILLING & CHECKOUT (STRIPE & RAZORPAY)
# ==============================================================================

# Stripe Publishable Client Key (used by Stripe Elements & client-side checkout)
# Status: OPTIONAL in dev | REQUIRED in production if Stripe is enabled
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Local: replace_with_your_stripe_publishable_key
# Production: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_with_your_stripe_publishable_key

# Razorpay Key ID (Client-side Merchant Key for Razorpay Checkout Modal)
# Status: OPTIONAL in dev | REQUIRED in production if Razorpay is enabled
# Obtain from: https://dashboard.razorpay.com/app/keys
# Local: replace_with_your_razorpay_key_id
# Production: rzp_live_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace_with_your_razorpay_key_id


# ==============================================================================
# 4. SUPABASE CLIENT SDK
# ==============================================================================

# Supabase Project Instance URL
# Status: OPTIONAL in development | Required if using direct Supabase client-side storage or auth
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# Example: https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co

# Supabase Anonymous Public Client API Key
# Status: OPTIONAL in development | Required for Supabase client SDK operations
# Obtain from: Supabase Project Settings -> API -> Project API Keys (anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key


# ==============================================================================
# 5. CLIENT ANALYTICS & TELEMETRY
# ==============================================================================

# Google Analytics 4 (GA4) Measurement ID
# Status: OPTIONAL
# Obtain from: Google Analytics Admin -> Data Streams -> Measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=replace_with_your_ga_measurement_id

# PostHog Public Client API Key (Client-side event capture)
# Status: OPTIONAL
# Obtain from: https://us.posthog.com/project/settings
# Example: phc_...
NEXT_PUBLIC_POSTHOG_KEY=replace_with_your_posthog_key

# PostHog Ingestion API Host
# Status: OPTIONAL (Defaults to: https://us.i.posthog.com)
# US Cloud: https://us.i.posthog.com | EU Cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ==============================================================================
# 6. CLIENT ERROR TRACKING & MONITORING
# ==============================================================================

# Sentry DSN for Frontend Error Capturing & Web Vitals Performance
# Status: OPTIONAL in development | Recommended in production
# Obtain from: https://sentry.io/settings/projects/
# Example: https://xxxxxx@o123456.ingest.sentry.io/78910
NEXT_PUBLIC_SENTRY_DSN=replace_with_your_sentry_dsn
