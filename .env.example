# ==============================================================================
# ResumeIQ AI — Master Environment Configuration Template (.env.example)
# ==============================================================================
# Unified environment template for both FastAPI Backend and Next.js Frontend.
# For local development:
#   1. Copy this file to .env at the root, OR:
#   2. Copy backend/.env.example to backend/.env AND frontend/.env.example to frontend/.env.local
#
# Refer to SETUP_ENVIRONMENT.md for detailed key acquisition and deployment instructions.
# NEVER commit populated .env files or private credentials to git.
# ==============================================================================


# ==============================================================================
# DATABASE
# ==============================================================================

# Database Connection URI (SQLAlchemy / PostgreSQL / SQLite)
# Required
# Development: SQLite (sqlite:///./resumeiq.db) or local Postgres
# Production: Supabase / Neon / AWS RDS PostgreSQL
# SQLite Example: sqlite:///./resumeiq.db
# PostgreSQL Example: postgresql://postgres:your_password@db.xxxxxx.supabase.co:5432/postgres
# Supabase Pooler: postgresql://postgres.xxxxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=sqlite:///./resumeiq.db

# Database Connection Pool Size
# Optional (Defaults to: 5)
# Development: 5 | Production: 10 - 20
DB_POOL_SIZE=5

# Database Max Overflow Connections
# Optional (Defaults to: 10)
# Development: 10 | Production: 20
DB_MAX_OVERFLOW=10

# Log SQL queries to console
# Optional (Defaults to: false)
# Development: true | Production: false
DB_ECHO=false


# ==============================================================================
# AUTHENTICATION
# ==============================================================================

# NextAuth Session Encryption Secret
# Required if using NextAuth session signing
# Generate using: openssl rand -base64 32
# Development: super-secret-development-key-resumeiq-ai-2026 | Production: 32+ character random string
NEXTAUTH_SECRET=super-secret-development-key-resumeiq-ai-2026

# NextAuth Canonical Base URL
# Optional (Defaults to: http://localhost:3000)
# Development: http://localhost:3000 | Production: https://resumeiq.ai
NEXTAUTH_URL=http://localhost:3000


# ==============================================================================
# AI (GOOGLE GEMINI)
# ==============================================================================

# Google Gemini AI Studio API Key
# Required for live generative AI (Resume Tailor, Bullet Improver, Interview Questions)
# Obtain from: https://aistudio.google.com/app/apikey (Free tier available)
# Development: your_gemini_api_key (Local NLP fallback active if key is not configured)
# Production: Required live Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key

# Google Gemini Foundation Model Identifier
# Optional (Defaults to: gemini-1.5-flash)
# Options: gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
# Development: gemini-1.5-flash | Production: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash


# ==============================================================================
# PAYMENTS (STRIPE & RAZORPAY)
# ==============================================================================

# Stripe Secret API Key (Server-side)
# Required if Stripe payments are enabled
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Development: sk_test_mock_stripe_key_resumeiq | Production: sk_live_...
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_resumeiq

# Stripe Publishable Client Key (Client & Server)
# Required if Stripe payments are enabled
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Development: pk_test_mock_stripe_key_resumeiq | Production: pk_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_key_resumeiq
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_key_resumeiq

# Stripe Webhook Signing Secret (Verifies inbound Stripe events)
# Required for production webhook reconciliation
# Obtain from: Stripe Dashboard -> Developers -> Webhooks
# Development: whsec_mock_stripe_secret | Production: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_secret

# Razorpay Key ID (Public merchant identifier)
# Required if Razorpay payments are enabled (UPI / Cards / Netbanking)
# Obtain from: https://dashboard.razorpay.com/app/keys
# Development: rzp_test_mock_key_resumeiq | Production: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_mock_key_resumeiq
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_key_resumeiq

# Razorpay Key Secret (Server-side merchant secret key)
# Required if Razorpay payments are enabled
# Obtain from: https://dashboard.razorpay.com/app/keys
# Development: mock_razorpay_secret_resumeiq | Production: live_razorpay_secret
RAZORPAY_KEY_SECRET=mock_razorpay_secret_resumeiq

# Razorpay Webhook Secret (Verifies payment signature on webhook callbacks)
# Required for production webhook reconciliation
# Obtain from: Razorpay Dashboard -> Settings -> Webhooks
# Development: mock_razorpay_webhook_secret | Production: live_razorpay_webhook_secret
RAZORPAY_WEBHOOK_SECRET=mock_razorpay_webhook_secret


# ==============================================================================
# SUPABASE (DATABASE, STORAGE & CLIENT SDK)
# ==============================================================================

# Supabase Project Instance URL
# Optional in development | Required for Supabase integrations
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Public Client API Key
# Optional in development | Required for Supabase client operations
# Obtain from: Supabase Project Settings -> API -> Project API Keys (anon / public)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (Privileged server-side key; bypasses RLS)
# Optional in development | Required for server-side admin operations
# Obtain from: Supabase Project Settings -> API -> Project API Keys (service_role)
# NEVER expose to client-side code!
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage Bucket for Candidate Resumes
# Optional (Defaults to: resumes)
# Development: resumes | Production: resumes
SUPABASE_BUCKET_NAME=resumes


# ==============================================================================
# ANALYTICS
# ==============================================================================

# Google Analytics 4 Measurement ID
# Optional
# Obtain from: Google Analytics Admin -> Data Streams -> Measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
GA_MEASUREMENT_ID=

# PostHog API Key (Server & Client)
# Optional
# Obtain from: https://us.posthog.com/project/settings
# Example: phc_abcdef1234567890
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog Host Endpoint
# Optional (Defaults to: https://us.i.posthog.com)
# US Cloud: https://us.i.posthog.com | EU Cloud: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ==============================================================================
# MONITORING & ERROR TRACKING
# ==============================================================================

# Sentry DSN (Backend & Frontend)
# Optional in development | Recommended in production
# Obtain from: https://sentry.io/settings/projects/
# Example: https://xxxxxx@o123456.ingest.sentry.io/78910
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Environment Tag
# Optional (Defaults to: development)
# Development: development | Production: production
SENTRY_ENVIRONMENT=development

# Sentry Performance Traces Sample Rate
# Optional (Defaults to: 0.1)
# Development: 1.0 | Production: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1


# ==============================================================================
# EMAIL SERVICES (SMTP)
# ==============================================================================

# SMTP Outbound Mail Server Hostname
# Optional in development | Required in production for billing invoices & resets
# Providers: Resend (smtp.resend.com), SendGrid (smtp.sendgrid.net), AWS SES
# Example: smtp.resend.com
SMTP_HOST=

# SMTP Server Port
# Optional (Defaults to: 587)
# Standard TLS: 587 | SSL: 465
SMTP_PORT=587

# SMTP Authentication Username
# Optional (e.g. "resend" or "apikey")
SMTP_USER=

# SMTP Authentication Password / API Token
# Optional (e.g. "re_123456789")
SMTP_PASSWORD=

# Verified From Address Header for Outgoing Emails
# Optional (Defaults to: ResumeIQ AI <noreply@resumeiq.ai>)
# Development: noreply@resumeiq.ai | Production: ResumeIQ AI <noreply@yourdomain.com>
EMAIL_FROM=ResumeIQ AI <noreply@resumeiq.ai>


# ==============================================================================
# FRONTEND API & WEB APPLICATION
# ==============================================================================

# FastAPI Backend API Base URL
# Required
# Points Next.js client to FastAPI backend endpoints
# Development: http://127.0.0.1:8000/api | Production: https://api.resumeiq.ai/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Canonical Web Application URL (used for SEO canonicals, sitemaps, OpenGraph metadata)
# Required in Production | Optional in Development (Defaults to http://localhost:3000)
# Development: http://localhost:3000 | Production: https://resumeiq.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend Allowed Frontend Origins for CORS
# Required
# Development: http://localhost:3000 | Production: https://resumeiq.ai
FRONTEND_URL=http://localhost:3000

# Comma-separated CORS Origins list
# Optional
# Development: http://localhost:3000,http://127.0.0.1:3000 | Production: https://resumeiq.ai,https://www.resumeiq.ai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ==============================================================================
# SECURITY & CRYPTOGRAPHY
# ==============================================================================

# JWT Secret Signing Key for User Authentication Sessions
# Required
# MUST be changed in production. Generate using: openssl rand -hex 32
# Development: super-secret-development-key-resumeiq-ai-2026 | Production: 64-char random hex string
JWT_SECRET=super-secret-development-key-resumeiq-ai-2026
SECRET_KEY=super-secret-development-key-resumeiq-ai-2026

# AES-256 Symmetric Encryption Key (32-byte Base64 key for encrypting sensitive data at rest)
# Optional in development | Recommended in production
# Generate using: openssl rand -base64 32
# Example: 7xK3v9QW8yZ4P1mN0L+rT6vB8xZ2wQ5aJ7uI3oK1mP0=
ENCRYPTION_KEY=

# Rate Limit Threshold (Requests per minute per IP)
# Optional (Defaults to: 60)
# Development: 120 | Production: 60
RATE_LIMIT_PER_MINUTE=60


# ==============================================================================
# STORAGE & APPLICATION RUNTIME
# ==============================================================================

# Application Display Name
PROJECT_NAME="ResumeIQ AI — AI-Powered ATS Resume Analyzer"

# Runtime Environment Mode (development | staging | production | test)
ENVIRONMENT=development

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Storage Engine Provider (local | supabase | s3)
STORAGE_TYPE=local

# Local File Uploads Directory
UPLOAD_DIR=./uploads

# Maximum Upload File Size Limit in Megabytes
MAX_FILE_SIZE_MB=10

# Recruiter Dashboard & AI Hiring Copilot Feature Flag
ENABLE_RECRUITER_DASHBOARD=true

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
