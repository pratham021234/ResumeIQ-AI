# ==============================================================================
# ResumeIQ AI — Backend Environment Template (backend/.env.example)
# ==============================================================================
# This template defines environment variables for the FastAPI backend service.
# Location: backend/.env.example
# Copy this file to: backend/.env (or root .env)
#
# SECURITY NOTICE:
# - NEVER commit populated .env files to version control.
# - Safe placeholders like `replace_with_...` are used below.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION & SERVER
# ==============================================================================

# Application display name
# Status: OPTIONAL (Defaults to: ResumeIQ AI — AI-Powered ATS Resume Analyzer)
# Local: "ResumeIQ AI — AI-Powered ATS Resume Analyzer"
# Production: "ResumeIQ AI"
PROJECT_NAME="ResumeIQ AI — AI-Powered ATS Resume Analyzer"

# Runtime environment mode
# Status: REQUIRED
# Options: development | staging | production | test
# Local: development
# Production: production
ENVIRONMENT=development

# Server host interface binding
# Status: OPTIONAL (Defaults to: 127.0.0.1)
# Local: 127.0.0.1
# Production: 0.0.0.0 (Container / Cloud host binding)
HOST=127.0.0.1

# Server port
# Status: OPTIONAL (Defaults to: 8000)
# Local: 8000
# Production: Set by platform (e.g. $PORT on Railway / Render)
PORT=8000

# Primary Web Application URL (used for CORS and redirect origins)
# Status: REQUIRED
# Local: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Additional Allowed CORS Origins (comma-separated if multiple)
# Status: OPTIONAL (Defaults to FRONTEND_URL and localhost:3000)
# Local: http://localhost:3000,http://127.0.0.1:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Recruiter Dashboard & AI Hiring Copilot feature flag
# Status: OPTIONAL (Defaults to: true)
# Local: true
# Production: true
ENABLE_RECRUITER_DASHBOARD=true

# Logging Level
# Status: OPTIONAL (Defaults to: INFO)
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Local: DEBUG or INFO
# Production: INFO or WARNING
LOG_LEVEL=INFO


# ==============================================================================
# 2. DATABASE CONFIGURATION
# ==============================================================================

# Primary Database Connection URI (SQLAlchemy connection string)
# Status: REQUIRED
# Local: sqlite:///./resumeiq.db (local SQLite file)
# Production: postgresql://username:password@hostname:5432/database_name (Supabase/Neon/AWS RDS)
# Supabase Pooler Example: postgresql://postgres.xxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=sqlite:///./resumeiq.db

# Database Connection Pool Size (PostgreSQL / MySQL only; ignored for SQLite)
# Status: OPTIONAL (Defaults to: 5)
# Local: 5
# Production: 10 - 20 depending on server concurrency
DB_POOL_SIZE=5

# Database Max Overflow Connections (PostgreSQL / MySQL only; ignored for SQLite)
# Status: OPTIONAL (Defaults to: 10)
# Local: 10
# Production: 20
DB_MAX_OVERFLOW=10

# Database SQL Query Logging (Echo SQL statements to console)
# Status: OPTIONAL (Defaults to: false)
# Local: true (for debugging query performance)
# Production: false (for performance and log hygiene)
DB_ECHO=false


# ==============================================================================
# 3. AUTHENTICATION & SECURITY
# ==============================================================================

# JWT Secret Signing Key for User Authentication Sessions
# Status: REQUIRED
# Generate with: openssl rand -hex 32
# Local: replace_with_secure_random_256_bit_secret
# Production: 64-character high-entropy random hex string
SECRET_KEY=replace_with_secure_random_256_bit_secret

# JWT Secret Alias (Compatible with microservices / external auth configs)
# Status: OPTIONAL (Defaults to SECRET_KEY if omitted)
# Local: replace_with_secure_random_256_bit_secret
# Production: 64-character high-entropy random hex string
JWT_SECRET=replace_with_secure_random_256_bit_secret

# JWT Signature Algorithm
# Status: OPTIONAL (Defaults to: HS256)
# Local: HS256
# Production: HS256
ALGORITHM=HS256

# Access Token Validity Window in Minutes
# Status: OPTIONAL (Defaults to: 1440 = 24 hours)
# Local: 1440
# Production: 1440
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256 Symmetric Encryption Key (32-byte Base64 key for encrypting sensitive data at rest)
# Status: OPTIONAL in development | Recommended in production
# Generate with: openssl rand -base64 32
# Example placeholder: replace_with_32_byte_base64_encryption_key
ENCRYPTION_KEY=replace_with_32_byte_base64_encryption_key

# NextAuth Session Secret (Compatible with Next.js frontend auth)
# Status: OPTIONAL
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_secure_random_secret

# NextAuth Canonical URL
# Status: OPTIONAL (Defaults to: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Client ID (Feature: Planned / Not yet implemented in core auth routes)
# Status: OPTIONAL
GOOGLE_CLIENT_ID=replace_with_your_google_client_id

# Google OAuth Client Secret (Feature: Planned / Not yet implemented in core auth routes)
# Status: OPTIONAL
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret

# Rate Limit Threshold (Requests per minute per IP)
# Status: OPTIONAL (Defaults to: 60)
# Local: 120
# Production: 60
RATE_LIMIT_PER_MINUTE=60


# ==============================================================================
# 4. AI INTEGRATION (GOOGLE GEMINI)
# ==============================================================================

# Google Gemini AI Studio API Key
# Status: REQUIRED for live generative features (Resume Tailor, Bullet Improver, Interview Questions)
# Obtain from: https://aistudio.google.com/app/apikey (Free tier available)
# Local: replace_with_your_gemini_api_key (Local NLP fallback active if key is not configured)
# Production: Required live Google AI Studio API key
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Google Gemini Foundation Model Identifier
# Status: OPTIONAL (Defaults to: gemini-1.5-flash)
# Options: gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
# Local: gemini-1.5-flash
# Production: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash


# ==============================================================================
# 5. SUBSCRIPTION BILLING & PAYMENTS (STRIPE & RAZORPAY)
# ==============================================================================

# Stripe Secret API Key (Server-side key for checkout sessions & subscriptions)
# Status: OPTIONAL in dev | REQUIRED in production if Stripe is enabled
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Local: replace_with_your_stripe_secret_key
# Production: sk_live_...
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key

# Stripe Publishable Key
# Status: OPTIONAL in dev | REQUIRED in production if Stripe is enabled
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Local: replace_with_your_stripe_publishable_key
# Production: pk_live_...
STRIPE_PUBLISHABLE_KEY=replace_with_your_stripe_publishable_key

# Stripe Webhook Signing Secret (Verifies inbound Stripe event signatures)
# Status: OPTIONAL in dev | REQUIRED in production for webhook verification
# Obtain from: Stripe Dashboard -> Developers -> Webhooks
# Local: replace_with_your_stripe_webhook_secret
# Production: whsec_...
STRIPE_WEBHOOK_SECRET=replace_with_your_stripe_webhook_secret

# Razorpay Key ID (Merchant identifier for Razorpay Checkout)
# Status: OPTIONAL in dev | REQUIRED in production if Razorpay is enabled
# Obtain from: https://dashboard.razorpay.com/app/keys
# Local: replace_with_your_razorpay_key_id
# Production: rzp_live_...
RAZORPAY_KEY_ID=replace_with_your_razorpay_key_id

# Razorpay Key Secret (Server-side merchant secret key)
# Status: OPTIONAL in dev | REQUIRED in production if Razorpay is enabled
# Obtain from: https://dashboard.razorpay.com/app/keys
# Local: replace_with_your_razorpay_key_secret
# Production: live_razorpay_key_secret
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret

# Razorpay Webhook Secret (Verifies payment signature on webhook callbacks)
# Status: OPTIONAL in dev | REQUIRED in production for webhook verification
# Obtain from: Razorpay Dashboard -> Settings -> Webhooks
# Local: replace_with_your_razorpay_webhook_secret
# Production: live_razorpay_webhook_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret


# ==============================================================================
# 6. SUPABASE (MANAGED STORAGE & CLOUD DATABASE)
# ==============================================================================

# Supabase Project Instance URL
# Status: OPTIONAL in development | Recommended in production
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# Example: https://your_project_ref.supabase.co
SUPABASE_URL=https://your_project_ref.supabase.co

# Supabase Anonymous Public Client API Key
# Status: OPTIONAL in development | Required for Supabase client operations
# Obtain from: Supabase Project Settings -> API -> Project API Keys (anon / public)
SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key

# Supabase Service Role Secret Key (Privileged server-side key; bypasses Row Level Security)
# Status: OPTIONAL in development | Required for server-side admin operations
# Obtain from: Supabase Project Settings -> API -> Project API Keys (service_role)
# NEVER expose this key to frontend or client code!
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Supabase Storage Bucket for Candidate Resumes
# Status: OPTIONAL (Defaults to: resumes)
# Local: resumes
# Production: resumes
SUPABASE_BUCKET_NAME=resumes


# ==============================================================================
# 7. FILE STORAGE & UPLOADS
# ==============================================================================

# Storage Engine Provider
# Status: OPTIONAL (Defaults to: local)
# Options: local | supabase | s3
# Local: local
# Production: local or supabase
STORAGE_TYPE=local

# Local File Uploads Directory
# Status: OPTIONAL (Defaults to: ./uploads)
# Local: ./uploads
# Production: ./uploads or persistent volume mount
UPLOAD_DIR=./uploads

# Maximum Upload File Size Limit in Megabytes
# Status: OPTIONAL (Defaults to: 10)
# Local: 10
# Production: 10
MAX_FILE_SIZE_MB=10


# ==============================================================================
# 8. ANALYTICS & TELEMETRY
# ==============================================================================

# PostHog Project API Key (Server-side event tracking)
# Status: OPTIONAL
# Obtain from: https://us.posthog.com/project/settings
# Local: Leave blank or set test key
# Production: phc_...
POSTHOG_API_KEY=replace_with_your_posthog_api_key

# PostHog Ingestion API Host
# Status: OPTIONAL (Defaults to: https://us.i.posthog.com)
# Options: https://us.i.posthog.com (US Cloud) | https://eu.i.posthog.com (EU Cloud)
POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (GA4) Measurement ID
# Status: OPTIONAL
# Obtain from: Google Analytics Admin -> Data Streams -> Measurement ID
# Example: G-XXXXXXXXXX
GA_MEASUREMENT_ID=replace_with_your_ga_measurement_id


# ==============================================================================
# 9. MONITORING & ERROR TRACKING
# ==============================================================================

# Sentry DSN (Backend error tracking and performance APM)
# Status: OPTIONAL in development | Recommended in production
# Obtain from: https://sentry.io/settings/projects/
# Example: https://xxxxxx@o123456.ingest.sentry.io/78910
SENTRY_DSN=replace_with_your_sentry_dsn

# Sentry Environment Tag
# Status: OPTIONAL (Defaults to ENVIRONMENT setting)
# Local: development
# Production: production
SENTRY_ENVIRONMENT=development

# Sentry Performance Traces Sample Rate (0.0 to 1.0)
# Status: OPTIONAL (Defaults to: 0.1)
# Local: 1.0
# Production: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1


# ==============================================================================
# 10. TRANSACTIONAL EMAIL & NOTIFICATIONS
# ==============================================================================

# SMTP Outbound Mail Server Hostname
# Status: OPTIONAL in development | Required in production for billing invoices & resets
# Providers: Resend (smtp.resend.com), SendGrid (smtp.sendgrid.net), AWS SES
# Example: smtp.resend.com
SMTP_HOST=smtp.resend.com

# SMTP Server Port
# Status: OPTIONAL (Defaults to: 587)
# Standard TLS: 587 | SSL: 465
SMTP_PORT=587

# SMTP Authentication Username
# Status: OPTIONAL (e.g. "resend" or "apikey")
SMTP_USER=replace_with_your_smtp_user

# SMTP Authentication Password / API Token
# Status: OPTIONAL
SMTP_PASSWORD=replace_with_your_smtp_password

# Direct Resend API Key (Alternative to SMTP)
# Status: OPTIONAL
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=replace_with_your_resend_api_key

# Verified From Address Header for Outgoing Emails
# Status: OPTIONAL (Defaults to: ResumeIQ AI <noreply@resumeiq.ai>)
# Local: ResumeIQ AI <noreply@resumeiq.ai>
# Production: ResumeIQ AI <noreply@yourdomain.com>
EMAIL_FROM=ResumeIQ AI <noreply@resumeiq.ai>

# Use STARTTLS Encryption
# Status: OPTIONAL (Defaults to: true)
SMTP_TLS=true

# Use Direct SSL Encryption
# Status: OPTIONAL (Defaults to: false)
SMTP_SSL=false
