# ==============================================================================
# ResumeIQ AI — Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env (or backend/.env) and populate the values for your environment.
# NEVER commit your actual .env file or sensitive secrets to version control.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION & SERVER SETTINGS
# ==============================================================================

# Application Display Name
# Optional (Defaults to: ResumeIQ AI — AI-Powered ATS Resume Analyzer)
# Development: Any descriptive name | Production: Branded SaaS title
PROJECT_NAME="ResumeIQ AI — AI-Powered ATS Resume Analyzer"

# Runtime Environment Mode
# Required
# Options: development | staging | production | test
# Development: development | Production: production
ENVIRONMENT=development

# Server Host Interface Binding
# Optional (Defaults to: 127.0.0.1)
# Development: 127.0.0.1 or 0.0.0.0 | Production: 0.0.0.0 (Container / Cloud host)
HOST=127.0.0.1

# Server Port
# Optional (Defaults to: 8000)
# Development: 8000 | Production: Provided by cloud platform ($PORT on Railway/Render)
PORT=8000

# Primary Web Application URL (used for CORS and redirect origins)
# Required
# Development: http://localhost:3000 | Production: https://resumeiq.ai
FRONTEND_URL=http://localhost:3000

# Additional Allowed CORS Origins (comma-separated if multiple)
# Optional (Defaults to FRONTEND_URL and localhost:3000)
# Development: http://localhost:3000,http://127.0.0.1:3000 | Production: https://resumeiq.ai,https://www.resumeiq.ai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Recruiter Dashboard & AI Hiring Copilot Feature Flag
# Optional (Defaults to: true)
# Development: true | Production: true
ENABLE_RECRUITER_DASHBOARD=true

# Logging Level
# Optional (Defaults to: INFO)
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Development: DEBUG or INFO | Production: INFO or WARNING
LOG_LEVEL=INFO


# ==============================================================================
# 2. DATABASE CONFIGURATION
# ==============================================================================

# Primary Database Connection URI (SQLAlchemy connection string)
# Required
# Development: SQLite (sqlite:///./resumeiq.db) or local PostgreSQL
# Production: Managed PostgreSQL (Supabase, Neon, AWS RDS, Railway Postgres)
# Obtain from: Supabase Settings -> Database -> Connection String (URI / Pooler)
# SQLite Example: sqlite:///./resumeiq.db
# PostgreSQL Example: postgresql://postgres:your_password@db.xxxxxx.supabase.co:5432/postgres
# Supabase Pooler Example: postgresql://postgres.xxxxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=sqlite:///./resumeiq.db

# Database Connection Pool Size (PostgreSQL only)
# Optional (Defaults to: 5)
# Development: 5 | Production: 10 - 20 depending on server concurrency
DB_POOL_SIZE=5

# Database Max Overflow Connections (PostgreSQL only)
# Optional (Defaults to: 10)
# Development: 10 | Production: 20
DB_MAX_OVERFLOW=10

# Database SQL Query Logging (Echo)
# Optional (Defaults to: false)
# Development: true for query debugging | Production: false for performance
DB_ECHO=false


# ==============================================================================
# 3. AUTHENTICATION & SECURITY
# ==============================================================================

# JWT Secret Signing Key for User Authentication Sessions
# Required
# MUST be changed in production. Generate using: openssl rand -hex 32
# Development: super-secret-development-key-resumeiq-ai-2026 | Production: 64-char random hex string
SECRET_KEY=super-secret-development-key-resumeiq-ai-2026

# JWT Secret Alias (Compatible with NextAuth / standard microservice specs)
# Optional (Defaults to SECRET_KEY if omitted)
# Development: super-secret-development-key-resumeiq-ai-2026 | Production: 64-char random hex string
JWT_SECRET=super-secret-development-key-resumeiq-ai-2026

# JWT Signature Algorithm
# Optional (Defaults to: HS256)
# Development: HS256 | Production: HS256
ALGORITHM=HS256

# Access Token Validity Window in Minutes
# Optional (Defaults to: 1440 = 24 hours)
# Development: 1440 | Production: 1440 (or shorter with refresh tokens)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256 Symmetric Encryption Key (32-byte Base64 key for encrypting sensitive data at rest)
# Optional in development | Recommended in production
# Generate using: openssl rand -base64 32
# Example: 7xK3v9QW8yZ4P1mN0L+rT6vB8xZ2wQ5aJ7uI3oK1mP0=
ENCRYPTION_KEY=

# Rate Limit Threshold (Requests per minute per IP)
# Optional (Defaults to: 60)
# Development: 120 | Production: 60
RATE_LIMIT_PER_MINUTE=60


# ==============================================================================
# 4. AI INTEGRATION (GOOGLE GEMINI)
# ==============================================================================

# Google Gemini AI Studio API Key
# Required for live generative AI (Resume Tailor, Bullet Improver, Interview Questions)
# Obtain from: https://aistudio.google.com/app/apikey (Free tier available)
# Development: your_gemini_api_key (Local NLP fallback active if key is not configured)
# Production: Required live Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key

# Google Gemini Foundation Model Identifier
# Optional (Defaults to: gemini-1.5-flash)
# Options: gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
# Development: gemini-1.5-flash | Production: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash


# ==============================================================================
# 5. SUBSCRIPTION BILLING & PAYMENTS (STRIPE & RAZORPAY)
# ==============================================================================

# Stripe Secret API Key (Secret server-side key for checkout & subscription billing)
# Required if Stripe payments are enabled
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Development: sk_test_... | Production: sk_live_...
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_resumeiq

# Stripe Publishable Client Key (Public key passed to client SDK)
# Required if Stripe payments are enabled
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Development: pk_test_... | Production: pk_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_key_resumeiq

# Stripe Webhook Signing Secret (Verifies authenticity of inbound webhook events)
# Required for production webhook reconciliation
# Obtain from: Stripe Dashboard -> Developers -> Webhooks (or Stripe CLI: stripe listen)
# Development: whsec_... | Production: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_secret

# Razorpay Key ID (Public merchant identifier)
# Required if Razorpay payments are enabled (India / International cards / UPI)
# Obtain from: https://dashboard.razorpay.com/app/keys
# Development: rzp_test_... | Production: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_mock_key_resumeiq

# Razorpay Key Secret (Private merchant secret key)
# Required if Razorpay payments are enabled
# Obtain from: https://dashboard.razorpay.com/app/keys
# Development: mock_razorpay_secret_resumeiq | Production: live_razorpay_secret
RAZORPAY_KEY_SECRET=mock_razorpay_secret_resumeiq

# Razorpay Webhook Secret (Verifies Razorpay payment signature on webhook callbacks)
# Required for production webhook reconciliation
# Obtain from: Razorpay Dashboard -> Settings -> Webhooks
# Development: mock_razorpay_webhook_secret | Production: live_razorpay_webhook_secret
RAZORPAY_WEBHOOK_SECRET=mock_razorpay_webhook_secret


# ==============================================================================
# 6. SUPABASE (DATABASE, AUTH & STORAGE INTEGRATION)
# ==============================================================================

# Supabase Project Instance URL
# Optional in development (if using local SQLite) | Recommended in production
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=

# Supabase Anonymous Client Public Key
# Optional in development | Required for Supabase client-side integrations
# Obtain from: Supabase Project Settings -> API -> Project API Keys (anon / public)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (Privileged server-side key; bypasses Row Level Security)
# Optional in development | Required for server-side administrative storage/database ops
# Obtain from: Supabase Project Settings -> API -> Project API Keys (service_role)
# NEVER expose this key to frontend or client code!
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage Bucket for Uploaded Candidate Resumes
# Optional (Defaults to: resumes)
# Development: resumes | Production: resumes
SUPABASE_BUCKET_NAME=resumes


# ==============================================================================
# 7. FILE STORAGE & UPLOADS
# ==============================================================================

# Storage Engine Provider
# Optional (Defaults to: local)
# Options: local | supabase | s3
# Development: local | Production: local or supabase
STORAGE_TYPE=local

# Local File Uploads Directory
# Optional (Defaults to: ./uploads)
# Development: ./uploads | Production: ./uploads or persistent volume mount
UPLOAD_DIR=./uploads

# Maximum Upload File Size Limit in Megabytes
# Optional (Defaults to: 10)
# Development: 10 | Production: 10 (Strict validation on PDF and DOCX)
MAX_FILE_SIZE_MB=10


# ==============================================================================
# 8. ANALYTICS & TELEMETRY
# ==============================================================================

# PostHog Project API Key (Server-side tracking)
# Optional
# Obtain from: https://us.posthog.com/project/settings
# Development: Optional | Production: phc_...
POSTHOG_API_KEY=

# PostHog Ingestion Host
# Optional (Defaults to: https://us.i.posthog.com)
# US Cloud: https://us.i.posthog.com | EU Cloud: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 Measurement ID
# Optional
# Obtain from: Google Analytics Admin -> Data Streams -> Measurement ID
# Example: G-XXXXXXXXXX
GA_MEASUREMENT_ID=


# ==============================================================================
# 9. MONITORING & ERROR TRACKING
# ==============================================================================

# Sentry DSN (Data Source Name) for Error Reporting & Performance APM
# Optional in development | Recommended in production
# Obtain from: https://sentry.io/settings/projects/resumeiq/keys/
# Example: https://xxxxxx@o123456.ingest.sentry.io/78910
SENTRY_DSN=

# Sentry Environment Tag
# Optional (Defaults to ENVIRONMENT setting)
# Development: development | Production: production
SENTRY_ENVIRONMENT=development

# Sentry Distributed Tracing Sample Rate (0.0 = 0%, 1.0 = 100%)
# Optional (Defaults to: 0.1 in production, 1.0 in dev)
# Development: 1.0 | Production: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1


# ==============================================================================
# 10. TRANSACTIONAL EMAIL & NOTIFICATIONS (SMTP)
# ==============================================================================

# SMTP Outbound Mail Server Hostname
# Optional in development | Required in production for billing invoices & password resets
# Providers: Resend (smtp.resend.com), SendGrid (smtp.sendgrid.net), AWS SES, Brevo
# Example: smtp.resend.com
SMTP_HOST=

# SMTP Server Port
# Optional (Defaults to: 587)
# Standard TLS: 587 | SSL: 465
SMTP_PORT=587

# SMTP Authentication Username
# Optional (e.g. "resend" or "apikey")
SMTP_USER=

# SMTP Authentication Password / API Token
# Optional (e.g. "re_123456789")
SMTP_PASSWORD=

# Verified From Address Header for Outgoing Emails
# Optional (Defaults to: noreply@resumeiq.ai)
# Development: noreply@resumeiq.ai | Production: ResumeIQ AI <noreply@yourdomain.com>
EMAIL_FROM=ResumeIQ AI <noreply@resumeiq.ai>

# Use STARTTLS Encryption
# Optional (Defaults to: true)
SMTP_TLS=true

# Use Direct SSL Encryption
# Optional (Defaults to: false)
SMTP_SSL=false
