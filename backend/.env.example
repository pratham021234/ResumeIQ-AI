# Application
PROJECT_NAME="ResumeIQ AI"
ENVIRONMENT="development"
PORT=8000
HOST="127.0.0.1"
FRONTEND_URL="http://localhost:3000"

# Security
SECRET_KEY="super-secret-development-key-change-in-production-resumeiq-ai"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (defaults to SQLite if PostgreSQL is not specified)
DATABASE_URL="sqlite:///./resumeiq.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumeiq"

# Google Gemini API
GEMINI_API_KEY=""

# Upload directory
UPLOAD_DIR="./uploads"

# Feature Flags
ENABLE_RECRUITER_DASHBOARD=true

# Subscription Billing (Stripe & Razorpay)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# Analytics (Optional)
POSTHOG_API_KEY=""
GA_MEASUREMENT_ID=""
