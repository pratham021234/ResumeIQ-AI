# ==============================================================================
# ResumeIQ AI — Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Files & Secrets (NEVER commit to version control)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.*.local
.env.development
.env.test
.env.production
.env.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.*.local

# Whitelist safe example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Secret keys, certificates, and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Python Packages
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Caches & Test Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Node.js & Next.js Build Outputs
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.vercel/
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ------------------------------------------------------------------------------
# 5. Database Files (SQLite & Local Dumps)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/resumeiq.db
!backend/seed_data/

# ------------------------------------------------------------------------------
# 6. Uploads & Generated File Artifacts
# ------------------------------------------------------------------------------
uploads/
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/reports/.gitkeep
backend/uploads/reports/*
tmp/
temp/

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
